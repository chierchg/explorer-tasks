{
  "name": "explorer-tasks",
  "displayName": "Explorer Tasks",
  "description": "Run VS Code tasks directly from the Explorer.",
  "version": "0.3.0",
  "publisher": "yokopoco",
  "icon": "icon.png",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "tasks.json",
    "task runner",
    "explorer",
    "productivity"
  ],
  "main": "./extension.js",
  "license": "MIT",
  "scripts": {
    "check": "node --check extension.js",
    "test": "node --test",
    "vscode:prepublish": "npm run check && npm test",
    "package": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --no-dependencies --allow-missing-repository --out dist/explorer-tasks.vsix"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "explorerTasks.tasksView",
          "name": "Tasks",
          "icon": "icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "explorerTasks.runTask",
        "title": "Run",
        "category": "Explorer Tasks",
        "icon": "$(play)"
      },
      {
        "command": "explorerTasks.stopTask",
        "title": "Stop",
        "category": "Explorer Tasks",
        "icon": "$(debug-stop)"
      },
      {
        "command": "explorerTasks.refresh",
        "title": "Refresh",
        "category": "Explorer Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "explorerTasks.modifyTask",
        "title": "Modify",
        "category": "Explorer Tasks",
        "icon": "$(edit)"
      },
      {
        "command": "explorerTasks.toggleGroupExpansion",
        "title": "Toggle Group Expansion",
        "category": "Explorer Tasks",
        "icon": "$(expand-all)"
      },
      {
        "command": "explorerTasks.toggleViewMode",
        "title": "Toggle Flat/Tree View",
        "category": "Explorer Tasks"
      },
      {
        "command": "explorerTasks.expandGroups",
        "title": "Expand Groups",
        "category": "Explorer Tasks",
        "icon": "$(expand-all)"
      },
      {
        "command": "explorerTasks.collapseGroups",
        "title": "Collapse Groups",
        "category": "Explorer Tasks",
        "icon": "$(collapse-all)"
      },
      {
        "command": "explorerTasks.showFlatView",
        "title": "Show Flat View",
        "category": "Explorer Tasks",
        "icon": "$(list-flat)"
      },
      {
        "command": "explorerTasks.showTreeView",
        "title": "Show Tree View",
        "category": "Explorer Tasks",
        "icon": "$(list-tree)"
      }
    ],
    "configuration": {
      "title": "Explorer Tasks",
      "properties": {
        "explorerTasks.grouping.expanded": {
          "type": "boolean",
          "default": true,
          "description": "Expand task groups by default."
        },
        "explorerTasks.viewMode": {
          "type": "string",
          "enum": [
            "tree",
            "flat"
          ],
          "default": "tree",
          "description": "Display grouped task labels as a tree or a flat list."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "explorerTasks.tasksView",
        "contents": "No project tasks found."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "explorerTasks.runTask",
          "when": "false"
        },
        {
          "command": "explorerTasks.stopTask",
          "when": "false"
        },
        {
          "command": "explorerTasks.modifyTask",
          "when": "false"
        },
        {
          "command": "explorerTasks.expandGroups",
          "when": "false"
        },
        {
          "command": "explorerTasks.collapseGroups",
          "when": "false"
        },
        {
          "command": "explorerTasks.showFlatView",
          "when": "false"
        },
        {
          "command": "explorerTasks.showTreeView",
          "when": "false"
        },
        {
          "command": "explorerTasks.toggleViewMode",
          "when": "explorerTasks.hasTaskGroups"
        }
      ],
      "view/title": [
        {
          "command": "explorerTasks.refresh",
          "when": "view == explorerTasks.tasksView",
          "group": "navigation@3"
        },
        {
          "command": "explorerTasks.expandGroups",
          "when": "view == explorerTasks.tasksView && explorerTasks.hasTaskGroups && explorerTasks.treeViewMode && !explorerTasks.groupsExpanded",
          "group": "navigation@1"
        },
        {
          "command": "explorerTasks.collapseGroups",
          "when": "view == explorerTasks.tasksView && explorerTasks.hasTaskGroups && explorerTasks.treeViewMode && explorerTasks.groupsExpanded",
          "group": "navigation@1"
        },
        {
          "command": "explorerTasks.showFlatView",
          "when": "view == explorerTasks.tasksView && explorerTasks.hasTaskGroups && explorerTasks.treeViewMode",
          "group": "navigation@2"
        },
        {
          "command": "explorerTasks.showTreeView",
          "when": "view == explorerTasks.tasksView && explorerTasks.hasTaskGroups && !explorerTasks.treeViewMode",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "explorerTasks.runTask",
          "when": "view == explorerTasks.tasksView && viewItem == explorerTask",
          "group": "1_run@1"
        },
        {
          "command": "explorerTasks.stopTask",
          "when": "view == explorerTasks.tasksView && viewItem == explorerTaskRunning",
          "group": "inline@1"
        },
        {
          "command": "explorerTasks.modifyTask",
          "when": "view == explorerTasks.tasksView && (viewItem == explorerTask || viewItem == explorerTaskRunning)",
          "group": "inline@2"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
