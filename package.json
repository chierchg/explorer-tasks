{
  "name": "explorer-tasks",
  "displayName": "Explorer Tasks",
  "description": "Run VS Code tasks directly from the Explorer.",
  "version": "0.2.0",
  "publisher": "yokopoco",
  "icon": "icon.png",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "tasks.json",
    "task runner",
    "explorer",
    "productivity"
  ],
  "main": "./extension.js",
  "license": "MIT",
  "scripts": {
    "check": "node --check extension.js",
    "test": "node --test",
    "vscode:prepublish": "npm run check && npm test",
    "package": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --no-dependencies --allow-missing-repository --out dist/explorer-tasks.vsix"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "explorerTasks.tasksView",
          "name": "Tasks",
          "icon": "icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "explorerTasks.runTask",
        "title": "Run",
        "category": "Explorer Tasks",
        "icon": "$(play)"
      },
      {
        "command": "explorerTasks.stopTask",
        "title": "Stop",
        "category": "Explorer Tasks",
        "icon": "$(debug-stop)"
      },
      {
        "command": "explorerTasks.refresh",
        "title": "Refresh",
        "category": "Explorer Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "explorerTasks.openTasksFile",
        "title": "Open tasks.json",
        "category": "Explorer Tasks",
        "icon": "$(go-to-file)"
      },
      {
        "command": "explorerTasks.toggleGroupExpansion",
        "title": "Toggle Group Expansion",
        "category": "Explorer Tasks",
        "icon": "$(list-tree)"
      }
    ],
    "keybindings": [
      {
        "command": "explorerTasks.toggleGroupExpansion",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "view == explorerTasks.tasksView"
      }
    ],
    "configuration": {
      "title": "Explorer Tasks",
      "properties": {
        "explorerTasks.grouping.expanded": {
          "type": "boolean",
          "default": true,
          "description": "Expand task groups by default."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "explorerTasks.tasksView",
        "contents": "No project tasks found.\n[Open tasks.json](command:explorerTasks.openTasksFile)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "explorerTasks.runTask",
          "when": "false"
        },
        {
          "command": "explorerTasks.stopTask",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "explorerTasks.refresh",
          "when": "view == explorerTasks.tasksView",
          "group": "navigation"
        },
        {
          "command": "explorerTasks.openTasksFile",
          "when": "view == explorerTasks.tasksView",
          "group": "navigation@2"
        },
        {
          "command": "explorerTasks.toggleGroupExpansion",
          "when": "view == explorerTasks.tasksView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "explorerTasks.runTask",
          "when": "view == explorerTasks.tasksView && viewItem == explorerTask",
          "group": "inline@1"
        },
        {
          "command": "explorerTasks.stopTask",
          "when": "view == explorerTasks.tasksView && viewItem == explorerTaskRunning",
          "group": "inline@1"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
